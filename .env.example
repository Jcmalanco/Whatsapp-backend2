# ==========================================
# MALANCO CORP - Variables de entorno (Backend)
# ==========================================

# Entorno
NODE_ENV=development
PORT=4000

# --- Base de datos (Supabase Postgres) ---
# Cadena de conexion directa de Postgres que da Supabase (Settings > Database > Connection string)
DATABASE_URL=postgresql://usuario:password@host:5432/postgres
DATABASE_SSL=true

# --- Supabase (API + Storage) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloca_aqui_la_service_role_key
SUPABASE_STORAGE_BUCKET=malanco-archivos
# Segundos de vigencia de las URLs firmadas para archivos
SUPABASE_SIGNED_URL_EXPIRA_SEG=3600

# --- Autenticacion ---
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRA=8h

# --- CORS ---
# Dominios permitidos separados por coma. Se dejan dos variables porque el
# despliegue actual usa Vercel/Render y a futuro se movera a un dominio propio.
FRONTEND_URL_RENDER_VERCEL=https://malanco-corp.vercel.app
FRONTEND_URL_DOMINIO_PROPIO=https://app.malancocorp.com

# --- WhatsApp Cloud API (Meta) ---
# Se dejan preparadas, se completan cuando la cuenta de Meta este lista.
WHATSAPP_API_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
# Token que tu defines y registras en el panel de Meta para verificar el webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambia_este_token

# --- Multer / subida de archivos ---
MAX_FILE_SIZE_MB=25

# --- Asignacion automatica de chats ---
MAX_CHATS_SIMULTANEOS_DEFAULT=5
